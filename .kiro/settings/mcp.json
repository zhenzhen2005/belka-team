{
  "mcpServers": {
    "aws-mcp": {
      "command": "/Users/zhenzhen/.local/bin/uvx",
      "timeout": 100000,
      "args": [
        "mcp-proxy-for-aws-cli@1.8.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=ap-southeast-1"
      ],
      "autoApprove": [
        "aws___search_documentation",
        "aws___read_documentation",
        "aws___retrieve_skill",
        "aws___list_regions"
      ]
    },
    "strands-agents": {
      "command": "/Users/zhenzhen/.local/bin/uvx",
      "args": [
        "strands-agents-mcp-server@0.3.0"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "autoApprove": [
        "search_docs",
        "fetch_doc"
      ]
    },
    "agentcore-docs": {
      "command": "/Users/zhenzhen/.local/bin/uvx",
      "args": [
        "awslabs.amazon-bedrock-agentcore-mcp-server@0.2.1"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AGENTCORE_ENABLE_TOOLS": "docs"
      },
      "autoApprove": [
        "search_agentcore_docs",
        "fetch_agentcore_doc"
      ],
      "disabled": true
    }
  }
}
