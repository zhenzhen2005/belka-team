# ไม่บังคับ: ค่าเริ่มต้นในโค้ดตรงกฎบัญชีทีมอยู่แล้ว (.kiro/steering/aws.md)
# คัดลอกเป็น backend/.env เมื่ออยากเปลี่ยนโหมดหรือเวลา (ห้าม commit .env)

# ai = เรียก Bedrock · fallback = ใช้แผนมาตรฐานของ Trust Engine อย่างเดียว (ไม่ต้องล็อกอิน AWS)
BELKA_MODE=ai

# ห้ามเปลี่ยน: บัญชีทีมรับแค่ค่านี้ และห้ามใช้ model ID ที่ขึ้นต้น global. หรือ apac.
# BELKA_MODEL_ID=anthropic.claude-sonnet-5
# BELKA_REGION=ap-southeast-1

# เวลารวมสูงสุดของ AI ก่อนใช้แผนสำรอง (วินาที, ตาม S6) และจำนวนครั้งที่ลอง
BELKA_AI_TIMEOUT=8
BELKA_AI_ATTEMPTS=2
